# /etc/systemd/system/mywork-relay.service
[Unit]
Description=mywork voice relay (device upload -> OpenClaw 唐僧)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xspace
WorkingDirectory=/home/xspace/myWork-hub
Environment=PYTHONUNBUFFERED=1
Environment=DEVICE_TOKEN=__CHANGE_ME__
Environment=OPENCLAW_AGENT=tangseng
Environment=MAX_UPLOAD_MB=32
Environment=MYWORK_ROOT=/home/xspace/myWork
ExecStart=/usr/bin/python3 scripts/public_relay.py --port 8787 --root /home/xspace/myWork
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
