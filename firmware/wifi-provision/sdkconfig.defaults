# ---- Flash / PSRAM (Waveshare ESP32-S3-Touch-AMOLED-1.75C) ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ---- CPU (语音 AFE + WiFi/TLS 并发时保持实时性) ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Partition ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- HTTP / DNS ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_DHCPS=y

# ---- Log ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Codec (ES7210 双麦 ADC) ----
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_SPIFFS_PAGE_SIZE=512
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# ---- BLE (NimBLE，配网/状态，PSRAM 分配省内部 RAM) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MSYS1_POOL_SIZE=4096
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
